---
/**
 * The 1200×630 share-preview card. Not a page for visitors: the pipeline
 * screenshots it into dist/og.png (scripts/og-image.mjs) and then removes
 * it, so the image is always built from the current content and design.
 */
import BaseHead from "../components/BaseHead.astro";
import { content, ui } from "../data/content";

const { person } = content;
const [first = "", ...rest] = person.name.split(" ");
const [before = "", after = ""] = person.summary.split(person.highlight);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${person.name} · share card`}
      description={person.summary}
    >
      <meta name="robots" content="noindex" />
    </BaseHead>
  </head>
  <body class="og-body">
    <main class="og" data-og>
      <span class="og__tag">{ui.og.tag}</span>
      <div class="og__text">
        <h1 class="og__name">
          {first}
          <br />
          {rest.join(" ")}
          <svg viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true">
            <path d="M4 18 C 80 8, 150 26, 230 14 S 360 6, 396 16"></path>
          </svg>
        </h1>
        <p class="og__summary">
          {before}<mark>{person.highlight}</mark>{after}
        </p>
      </div>

      <div class="og__label">
        <span class="og__tape"></span>
        <p class="og__role">
          {person.label[0]}
          <br />
          {ui.og.at(person.company)}
        </p>
        <p class="og__meta">{person.location} · {person.tenure}</p>
      </div>

      <span class="og__stamp" data-og-pill hidden>
        <span data-og-tested></span>
      </span>
    </main>

    <script>
      import { ui } from "../data/content";

      // Real count from this deploy's run; the card is ready either way.
      const root = document.querySelector<HTMLElement>("[data-og]");
      fetch("/ci-report.json")
        .then((r) => (r.ok ? r.json() : null))
        .then((report: { totals?: { passed?: number } } | null) => {
          const passed = report?.totals?.passed;
          const pill = document.querySelector<HTMLElement>("[data-og-pill]");
          const text = document.querySelector("[data-og-tested]");
          if (pill && text && passed) {
            text.textContent = ui.og.tested(passed);
            pill.hidden = false;
          }
        })
        .catch(() => undefined)
        .finally(() => root?.setAttribute("data-og-ready", ""));
    </script>
  </body>
</html>

<style>
  .og-body {
    margin: 0;
  }

  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    box-sizing: border-box;
    padding: 64px 72px 56px 120px;
    background:
      linear-gradient(var(--margin-line), var(--margin-line)) 84px 0 / 3px 100%
        no-repeat,
      repeating-linear-gradient(
        transparent 0 35px,
        rgb(169 184 236 / 0.3) 35px 36px
      ),
      var(--grain),
      var(--page);
  }

  .og__tag {
    position: absolute;
    left: 120px;
    top: 34px;
    font: 700 20px/1 var(--font-mono);
  }

  .og__text {
    display: flex;
    flex-direction: column;
    gap: 44px;
    margin-top: 28px;
  }

  .og__name {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    font: 800 190px/0.8 var(--font-sans);
    letter-spacing: -0.055em;
    text-transform: lowercase;
  }

  .og__name svg {
    position: absolute;
    left: -2%;
    bottom: -22px;
    width: 78%;
    height: 30px;
    fill: none;
    stroke: var(--pen);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .og__summary {
    max-width: 30ch;
    font: 400 30px/1.4 var(--font-sans);
  }

  .og__label {
    position: absolute;
    right: 72px;
    top: 96px;
    width: 420px;
    padding: 30px 28px 24px;
    background: var(--label) var(--grain);
    box-shadow: 3px 4px 0 rgb(26 26 26 / 0.18);
    rotate: -3deg;
  }

  .og__tape {
    position: absolute;
    left: 36%;
    top: -16px;
    width: 120px;
    height: 32px;
    background: var(--tape-light);
    rotate: 4deg;
    clip-path: polygon(3% 0, 97% 6%, 100% 40%, 96% 100%, 4% 94%, 0 55%);
  }

  .og__role {
    font: 400 36px/1.15 var(--font-hand);
    text-transform: lowercase;
  }

  .og__meta {
    margin-top: 14px;
    font: 400 18px/1.4 var(--font-mono);
    text-transform: lowercase;
  }

  .og__stamp {
    position: absolute;
    right: 90px;
    bottom: 70px;
    padding: 12px 18px;
    border: 5px double var(--pen);
    color: var(--pen);
    font: 700 22px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    rotate: -8deg;
    opacity: 0.9;
  }
</style>
