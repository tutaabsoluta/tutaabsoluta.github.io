---
import BaseHead from "../components/BaseHead.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import HowIWork from "../components/HowIWork.astro";
import Intro from "../components/Intro.astro";
import Projects from "../components/Projects.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { content, ui } from "../data/content";

const { person } = content;
const title = `${person.name} · ${person.role}`;
const description = `${person.name}, ${person.role} at ${person.company} in ${person.location}. ${person.summary}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Generated by the pipeline from /og (scripts/og-image.mjs); no image in the repo.
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description}>
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:site_name" content={person.name} />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={ui.og.alt(person.name)} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
    </BaseHead>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ui.skipLink}
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <Intro />
      <Projects />
      <Experience />
      <HowIWork />
      <Contact />
    </main>

    <script>
      import { initCiStatus } from "../scripts/ci-status";
      import { initInteractions } from "../scripts/interactions";
      import { initReveal } from "../scripts/reveal";

      initInteractions();
      initReveal();
      void initCiStatus();
    </script>
  </body>
</html>
