---
/**
 * GitHub Pages serves this for any unknown address. It's the easter egg's
 * mirror image: a receipt where the one failing test is "this page exists",
 * with the visitor's real path and the real last run from /ci-report.json.
 */
import BaseHead from "../components/BaseHead.astro";
import PrintedShape from "../components/PrintedShape.astro";
import { ui } from "../data/content";

const t = ui.notFound;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={t.title} description={t.description}>
      <meta name="robots" content="noindex" />
    </BaseHead>
  </head>
  <body>
    <main class="lost">
      <article class="slip" aria-labelledby="lost-title">
        <p class="slip__kicker">{t.kicker}</p>
        <h1 id="lost-title" class="slip__title">
          {t.heading}
        </h1>
        <p class="slip__replay">{t.replaying}</p>
        <div class="search" aria-hidden="true">
          <span class="search__track"></span>
          <span class="search__glass">
            <PrintedShape
              size={56}
              offset={5}
              fill="var(--muted-blue)"
              radius="50%"
              glyph="⌕"
              glyphSize={26}
            />
          </span>
        </div>
        <ol class="slip__lines">
          <li class="slip__group">{t.group}</li>
          <li class="slip__line">
            <span aria-hidden="true">✓</span>
            <span>{t.siteUp}</span>
          </li>
          <li class="slip__line" data-lost-run hidden>
            <span aria-hidden="true">✓</span>
            <span data-lost-run-text></span>
          </li>
          <li class="slip__line">
            <span aria-hidden="true">✓</span>
            <span>{t.searched}</span>
          </li>
          <li class="slip__line">
            <span aria-hidden="true">✓</span>
            <span>{t.asked}</span>
          </li>
          <li class="slip__line slip__line--failed">
            <span aria-hidden="true">✗</span>
            <span data-lost-path>{t.pageExists("this address")}</span>
          </li>
        </ol>
        <pre class="slip__error"><span class="slip__error-head">{t.error}</span>
<span data-lost-expected>{t.expected("this address")}</span>
{t.received}</pre>
        <p class="slip__note">{t.note}</p>
        <div class="slip__end">
          <span class="slip__stamp">{t.stamp}</span>
          <a class="slip__home" href="/">
            {t.home}
          </a>
        </div>
      </article>
    </main>

    <script>
      import { ui } from "../data/content";

      const here = location.pathname;
      const path = document.querySelector("[data-lost-path]");
      if (path) path.textContent = ui.notFound.pageExists(here);
      const expected = document.querySelector("[data-lost-expected]");
      if (expected) expected.textContent = ui.notFound.expected(here);

      // The real last run, when the site has one (not in local dev).
      fetch("/ci-report.json")
        .then((r) => (r.ok ? r.json() : null))
        .then(
          (
            report: {
              run?: { number?: number };
              totals?: { passed?: number };
            } | null,
          ) => {
            const run = report?.run?.number;
            const passed = report?.totals?.passed;
            const line = document.querySelector<HTMLElement>("[data-lost-run]");
            const text = document.querySelector("[data-lost-run-text]");
            if (!line || !text || run == null || passed == null) return;
            text.textContent = ui.notFound.lastRun(run, passed);
            line.hidden = false;
          },
        )
        .catch(() => undefined);
    </script>
  </body>
</html>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 16px;
  }

  /* Same paper as the footer receipt: torn edges, mono lines, offset stamp. */
  .slip {
    --zz: 8px;
    width: min(400px, 100%);
    padding: 30px 24px 38px;
    background: var(--paper);
    font: 13px/1.45 var(--font-mono);
    filter: drop-shadow(6px 6px 0 var(--lavender));
    mask:
      conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg)
        top / calc(2 * var(--zz)) var(--zz) repeat-x,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg)
        bottom / calc(2 * var(--zz)) var(--zz) repeat-x,
      linear-gradient(#000 0 0) center / 100% calc(100% - 2 * var(--zz))
        no-repeat;
    rotate: -1deg;
    animation: slip-feed 0.45s var(--ease-settle);
  }

  @keyframes slip-feed {
    from {
      opacity: 0;
      translate: 0 -28px;
    }
  }

  .slip__kicker {
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .slip__title {
    margin-top: 6px;
    text-align: center;
    font: 800 64px/1 var(--font-display);
    font-stretch: 80%;
  }

  .slip__replay {
    margin: 10px auto 4px;
    width: fit-content;
    font: 700 17px/1.1 var(--font-note);
    color: var(--ink-blue);
    rotate: -2deg;
  }

  .slip__lines {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .slip__group {
    margin-top: 14px;
    padding-bottom: 4px;
    border-bottom: 1.5px dashed var(--graphite);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .slip__line {
    display: grid;
    grid-template-columns: 1.4em minmax(0, 1fr);
    gap: 8px;
    padding: 4px 0;
    overflow-wrap: anywhere;
  }

  .slip__line--failed {
    font-weight: 700;
  }

  /* The "gif": a magnifier pacing the receipt, looking for the page. The
     one looping animation on the site, kept to the 404 on purpose. */
  .search {
    position: relative;
    height: 74px;
    margin: 6px 0 2px;
  }

  .search__track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    border-bottom: 1.5px dashed var(--graphite);
    opacity: 0.4;
  }

  .search__glass {
    position: absolute;
    left: 0;
    top: 0;
    animation: search 3.2s var(--ease-settle) infinite;
  }

  @keyframes search {
    0%,
    100% {
      left: 0%;
      rotate: -10deg;
    }
    22%,
    30% {
      left: 38%;
    }
    22% {
      rotate: 8deg;
    }
    30% {
      rotate: 18deg;
    }
    55%,
    65% {
      left: calc(100% - 62px);
    }
    55% {
      rotate: -4deg;
    }
    65% {
      rotate: -16deg;
    }
    85% {
      left: 14%;
      rotate: 6deg;
    }
  }

  .slip__error {
    margin: 16px 0 0;
    padding: 10px 12px;
    border-left: 3px solid var(--signal-red);
    background: var(--cream);
    font: 12px/1.5 var(--font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .slip__error-head {
    font-weight: 700;
  }

  .slip__note {
    margin-top: 12px;
    text-align: center;
    font: 700 16px/1.2 var(--font-note);
    color: var(--text-muted);
    rotate: -1.5deg;
  }

  .slip__end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 3px double var(--graphite);
  }

  .slip__stamp {
    position: relative;
    isolation: isolate;
    padding: 8px 16px;
    border: 3px solid var(--graphite);
    border-radius: 10px;
    font: 800 28px/1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    rotate: -8deg;
    animation: slip-stamp 0.36s cubic-bezier(0.3, 1.5, 0.5, 1) 0.5s backwards;
  }

  .slip__stamp::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--signal-red);
    translate: 5px 5px;
  }

  @keyframes slip-stamp {
    from {
      opacity: 0;
      scale: 1.9;
      rotate: -2deg;
    }
  }

  .slip__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 700 15px/1 var(--font-body);
  }
</style>
