---
/**
 * Part 1 of the bug hunt (02): a live bug in the corner that runs away
 * from the cursor; the pencil note next to it changes with each escape,
 * and after the last one it runs off towards the volunteer page, where
 * the fight happens (BugFight.astro). Behaviour: scripts/bug-hunt.ts.
 * Decorative; desktop only (≥900px).
 */
import { ui } from "../data/content";
---

<div class="flee" aria-hidden="true" data-flee>
  <svg
    class="flee__bug"
    viewBox="0 -2 60 62"
    width="56"
    height="56"
    data-flee-bug
  >
    <path d="M30 18 C 40 18, 44 26, 43 34 C 42 44, 36 50, 30 50 C 24 50, 17 44, 17 34 C 16 26, 21 18, 30 18 Z M30 7 C 35 7, 37 11, 37 14 C 37 18, 34 20, 30 20 C 26 20, 23 18, 23 14 C 23 10, 26 7, 30 7 M27 8 L22 1 M33 8 L38 1 M18 28 L8 23 M17 35 L6 36 M19 43 L9 49 M42 28 L52 23 M43 35 L54 36 M41 43 L51 49 M30 21 V49"></path>
    <circle cx="27.5" cy="13.5" r="1.4"></circle>
    <circle cx="32.5" cy="13.5" r="1.4"></circle>
  </svg>
  <span class="scribble flee__note" data-flee-note>
    {ui.bug.flee[0]}
  </span>
</div>

<style>
  .flee {
    position: absolute;
    right: var(--gutter);
    bottom: 24px;
    width: 56px;
    height: 56px;
  }

  .flee__bug {
    position: relative;
    z-index: 2;
    display: block;
    overflow: visible;
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: url(#hand-drawn);
    rotate: -10deg;
    transition:
      translate 0.28s var(--ease-settle),
      rotate 0.28s var(--ease-settle);
  }

  .flee__bug circle {
    fill: var(--pen);
    stroke: none;
  }

  .flee__note {
    right: 66px;
    bottom: 16px;
    white-space: nowrap;
    rotate: -4deg;
  }

  .flee__note[data-changed] {
    animation: note-swap 0.3s var(--ease-settle);
  }

  @keyframes note-swap {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  @media (max-width: 899.98px) {
    .flee {
      display: none;
    }
  }
</style>
