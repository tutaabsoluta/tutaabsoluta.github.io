---
import { linkAttrs, toneVar, ui, type Project } from "../data/content";
import HandArrow from "./HandArrow.astro";
import PrintedShape from "./PrintedShape.astro";
import Sticker from "./Sticker.astro";

interface Props {
  project: Project;
  index: number;
}

const { project: p, index } = Astro.props;
const headingId = `project-${p.n}`;
const detailsId = `project-${p.n}-details`;
const tone = toneVar[p.tone];
---

<article
  class="project"
  aria-labelledby={headingId}
  data-fx="settle"
  data-delay={index * 120}
  style={`--tone:${tone}`}
>
  <Sticker label={p.status} place="right:-12px;top:-18px;rotate:6deg" />

  <div class="project__drawing" aria-hidden="true">
    <PrintedShape class="project__screen" fill={tone} radius="8px" offset={6}>
      <span class="bar bar--long"></span>
      <span class="bar bar--short"></span>
      <span class="project__button"></span>
    </PrintedShape>
    <HandArrow
      class="project__arrow"
      width={80}
      height={30}
      curve="M4 16 C 24 4, 50 26, 72 14"
      head="M64 8 L73 13 L66 21"
    />
    <PrintedShape
      class="project__check"
      size={72}
      fill="var(--dusty-green)"
      radius="50%"
      glyph="✓"
      glyphSize={32}
    />
  </div>

  <span class="project__kicker">{ui.build.kicker(p.n)}</span>
  <h3 id={headingId} class="project__title">
    {p.title}
  </h3>
  <p class="project__desc">{p.description}</p>
  <p class="project__stack">{p.stack.join(" · ")}</p>

  <div class="project__foot">
    <button
      type="button"
      class="project__toggle"
      aria-expanded="false"
      aria-controls={detailsId}
      data-disclosure
    >
      {ui.build.howItWorks}{" "}
      <span class="chevron" aria-hidden="true">
        ↓
      </span>
    </button>
    <a class="project__repo" href={p.repository} {...linkAttrs(p.repository)}>
      {p.repository}
    </a>
  </div>

  <dl id={detailsId} class="project__details" hidden>
    {p.details.map((r) => (
      <div class="row">
        <dt>{r.k}</dt>
        <dd>{r.v}</dd>
      </div>
    ))}
  </dl>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(18px, 2vw, 26px);
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-card);
    box-shadow: 8px 8px 0 var(--tone);
    rotate: var(--rot, 0deg);
    transition:
      rotate 0.2s var(--ease-settle),
      translate 0.2s var(--ease-settle);
  }

  @media (hover: hover) {
    .project:hover {
      rotate: 0deg;
      translate: 0 -3px;
      --printed-align: 1;
    }
  }

  .project__drawing {
    position: relative;
    height: clamp(140px, 16vw, 180px);
    border: var(--border);
    border-radius: var(--radius-button);
    background: var(--cream);
    overflow: hidden;
  }

  .project__drawing :global(.project__screen) {
    position: absolute;
    left: 12%;
    top: 20%;
    width: 120px;
    height: 90px;
  }

  .bar {
    position: absolute;
    left: 14px;
    height: 6px;
    background: var(--graphite);
  }

  .bar--long {
    top: 18px;
    width: 70px;
  }

  .bar--short {
    top: 34px;
    width: 50px;
  }

  .project__button {
    position: absolute;
    left: 14px;
    top: 56px;
    width: 36px;
    height: 18px;
    background: var(--soft-peach);
    border: 2px solid var(--graphite);
    border-radius: 4px;
  }

  .project__drawing :global(.project__arrow) {
    position: absolute;
    left: calc(12% + 132px);
    top: 38%;
  }

  .project__drawing :global(.project__check) {
    position: absolute;
    left: calc(12% + 222px);
    top: 22%;
  }

  .project__kicker {
    font: 700 13px/1 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .project__title {
    font: 800 clamp(26px, 2.6vw, 32px) / 1 var(--font-display);
    font-stretch: 85%;
    overflow-wrap: anywhere;
  }

  .project__desc {
    font: 18px/1.5 var(--font-body);
  }

  .project__stack {
    font: 15px/1.4 var(--font-body);
    color: var(--text-muted);
  }

  .project__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    border-top: 2px dashed var(--graphite);
    padding-top: 12px;
  }

  .project__toggle {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    font: 700 16px/1 var(--font-body);
    cursor: pointer;
    transition: scale 0.1s var(--ease-settle);
  }

  .project__toggle:active {
    scale: 0.96;
  }

  .chevron {
    display: inline-block;
    transition: rotate 0.25s var(--ease-settle);
  }

  .project__toggle[aria-expanded="true"] .chevron {
    rotate: 180deg;
  }

  .project__repo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 700 15px/1 var(--font-body);
  }

  .project__details {
    display: flex;
    flex-direction: column;
    border: var(--border);
    border-radius: var(--radius-button);
    overflow: hidden;
    animation: details-in 0.32s var(--ease-settle);
  }

  /* Replays each time `hidden` is lifted; rows follow the panel in. */
  .row {
    animation: details-in 0.32s var(--ease-settle) backwards;
  }

  .row:nth-child(2) {
    animation-delay: 40ms;
  }

  .row:nth-child(3) {
    animation-delay: 80ms;
  }

  .row:nth-child(n + 4) {
    animation-delay: 120ms;
  }

  @keyframes details-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding: 12px 14px;
    border-bottom: 2px solid var(--warm-beige);
    background: var(--paper);
  }

  .row:last-child {
    border-bottom: 0;
  }

  dt {
    flex: 0 0 130px;
    font: 800 16px/1.3 var(--font-display);
  }

  dd {
    flex: 1 1 180px;
    font: 16px/1.45 var(--font-body);
  }
</style>
