---
import { content, isUrl, linkAttrs, ui } from "../data/content";
import Crumbs from "./Crumbs.astro";
import FleeBug from "./FleeBug.astro";
import PageBreak from "./PageBreak.astro";
import Stamp from "./Stamp.astro";
import Tape from "./Tape.astro";

/** Each sheet has its own paper, tilt and tape; the second one is torn. */
const sheets = [
  { bg: "var(--sheet-1)", tape: "left:18%;rotate:-5deg", torn: false },
  { bg: "var(--sheet-2)", tape: "left:58%;rotate:4deg", torn: true },
];
---

<section id="build" class="section" aria-labelledby="h-build">
  <PageBreak
    page={ui.pages.build}
    label={ui.tabs.build}
    x={4}
    bg="var(--label)"
  />
  <div class="section-head">
    <p class="mono-kicker">{ui.build.kicker}</p>
    <h2 id="h-build" class="display-h2" data-fx="settle">
      {ui.build.title}
    </h2>
    <p class="pen-note build__note" data-fx="fade" data-delay="240">
      <span class="build__erased" aria-hidden="true">
        {ui.build.erased}
      </span>
      {ui.build.note}
    </p>
    <Crumbs place="position:relative;align-self:center;margin-left:-8px;width:60px;height:34px" />
    <div class="postit" aria-hidden="true" data-fx="drop" data-delay="380">
      <div class="postit__paper grain">
        <p class="postit__title">{ui.build.todo.title}</p>
        <ul>
          {ui.build.todo.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="build__sheets">
    {content.projects.map((p, i) => {
      const sheet = sheets[i % sheets.length] ?? sheets[0];
      const headingId = `project-${p.n}`;
      const detailsId = `project-${p.n}-details`;
      return (
        <article
          class:list={["sheet grain", { "sheet--torn": sheet?.torn }]}
          aria-labelledby={headingId}
          data-fx="settle"
          data-delay={i * 140}
          style={`--sheet:${sheet?.bg}`}
        >
          <Tape
            delay={i * 140 + 300}
            place={`${sheet?.tape};top:-10px;width:120px;height:30px`}
          />
          <Stamp
            label={ui.build.stamp}
            delay={i * 140 + 520}
            place="right:20px;top:26px"
          />
          <p class="sheet__kicker">{ui.build.project(p.n)}</p>
          <h3 id={headingId} class="sheet__title">
            {p.title}
          </h3>
          <p class="sheet__desc">{p.description}</p>
          <ul class="sheet__checklist">
            <li>
              <span class="sheet__box" aria-hidden="true">
                [<span class="sheet__x">x</span>]
              </span>{" "}
              {ui.build.started}
            </li>
            <li>
              <span class="sheet__box" aria-hidden="true">
                [&nbsp;]
              </span>{" "}
              {ui.build.finished}{" "}
              <span class="sheet__not-yet">{ui.build.notYet}</span>
            </li>
          </ul>
          <p class="sheet__stack">{p.stack.join(" + ")}</p>

          <button
            type="button"
            class="sheet__toggle"
            aria-expanded="false"
            aria-controls={detailsId}
            data-disclosure
          >
            {ui.build.howItWorks}
            <span class="sheet__chevron" aria-hidden="true">
              ↓
            </span>
          </button>
          <dl id={detailsId} class="sheet__details" hidden>
            {p.details.map((r) => (
              <div class="sheet__row">
                <dt>{r.k}:</dt>
                <dd>{r.v}</dd>
              </div>
            ))}
          </dl>

          <p class="sheet__repo">
            {ui.build.repo}{" "}
            {isUrl(p.repository) ? (
              <a class="swipe" href={p.repository} {...linkAttrs(p.repository)}>
                {p.repository}
              </a>
            ) : (
              <span class="sheet__placeholder">{p.repository}</span>
            )}
          </p>
        </article>
      );
    })}
  </div>

  <FleeBug />
</section>

<style>
  /* A sticky note with the projects' honest TODO list (decorative: the
     status is already said in "(both still unfinished)"). Its corner peels
     up when you touch it. */
  @property --peel {
    syntax: "<length>";
    inherits: true;
    initial-value: 12px;
  }

  .postit {
    --peel: 12px;
    margin-left: auto;
    align-self: center;
    rotate: 4deg;
    filter: drop-shadow(1px 3px 2px rgb(26 26 26 / 0.22));
    transition:
      --peel 0.3s var(--ease-settle),
      rotate 0.3s var(--ease-settle);
  }

  @media (hover: hover) {
    .postit:hover {
      --peel: 30px;
      rotate: 2deg;
    }
  }

  .postit:active {
    --peel: 30px;
  }

  .postit__paper {
    position: relative;
    display: block;
    padding: 16px 18px 20px;
    background-color: var(--highlighter);
    font: 400 16px/1.3 var(--font-hand);
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--peel)),
      calc(100% - var(--peel)) 100%,
      0 100%
    );
  }

  .postit__title {
    margin-bottom: 4px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .postit__paper ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .postit__paper li::before {
    content: "\2610  ";
  }

  /* The folded-up flap. */
  .postit__paper::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: var(--peel);
    height: var(--peel);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--highlighter), var(--ink) 12%),
      color-mix(in srgb, var(--highlighter), var(--paper) 55%)
    );
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  @media (max-width: 699.98px) {
    .postit {
      margin: 8px 0 0;
    }
  }

  .build__note {
    position: relative;
    rotate: -3deg;
  }

  /* An earlier, too-optimistic note, rubbed out (not quite all the way). */
  .build__erased {
    position: absolute;
    left: 14px;
    top: -26px;
    padding: 0 6px;
    font: 400 18px/1 var(--font-hand);
    color: color-mix(in srgb, var(--pencil) 45%, transparent);
    background: radial-gradient(
      ellipse at center,
      rgb(26 26 26 / 0.08),
      transparent 72%
    );
    white-space: nowrap;
    rotate: 2deg;
  }

  .build__sheets {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 40px;
    align-items: flex-start;
  }

  /* A loose sheet: off-white paper, tilted, held down with tape. */
  .sheet {
    position: relative;
    flex: 1 1 420px;
    min-width: 0;
    padding: clamp(24px, 3vw, 36px);
    background-color: var(--sheet);
    box-shadow: var(--lift-lg);
    rotate: -1.2deg;
    transition:
      rotate 0.25s var(--ease-settle),
      translate 0.25s var(--ease-settle),
      box-shadow 0.25s var(--ease-settle);
  }

  .sheet--torn {
    rotate: 1.4deg;
    /* Torn bottom edge; the polygon reaches past the top and sides so the
       tape and shadow aren't cut off. */
    clip-path: polygon(
      -24px -40px,
      calc(100% + 24px) -40px,
      calc(100% + 24px) 97%,
      96% 100%,
      91% 97.5%,
      85% 100%,
      79% 97%,
      72% 99.5%,
      66% 97%,
      58% 100%,
      51% 97.5%,
      44% 100%,
      37% 97%,
      30% 99.5%,
      22% 97%,
      15% 100%,
      8% 97.5%,
      -24px 100%
    );
  }

  @media (min-width: 900px) {
    .sheet--torn {
      margin-top: 56px;
    }
  }

  @media (hover: hover) {
    .sheet:hover {
      rotate: -0.3deg;
      translate: 0 -4px;
      box-shadow: var(--lift-hover);
    }

    .sheet--torn:hover {
      rotate: 0.4deg;
    }
  }

  .sheet__kicker {
    margin: 28px 0 10px;
    font: 400 13px/1 var(--font-mono);
  }

  /* Narrow sheets: the stamp gets its own line above the kicker. */
  @media (max-width: 519.98px) {
    .sheet__kicker {
      margin-top: 58px;
    }
  }

  .sheet__title {
    margin-bottom: 14px;
    font: 800 clamp(26px, 2.8vw, 36px) / 1 var(--font-sans);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .sheet__desc {
    margin-bottom: 16px;
    font: 400 19px/1.5 var(--font-sans);
  }

  .sheet__checklist {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font: 400 15px/1.5 var(--font-mono);
  }

  /* The x is ticked in pen once the sheet lands. */
  .sheet__x {
    display: inline-block;
    font-family: var(--font-hand);
    color: var(--pen);
  }

  .fx [data-fx-done] .sheet__x {
    animation: tick 0.3s var(--ease-stamp) 0.7s backwards;
  }

  @keyframes tick {
    from {
      opacity: 0;
      scale: 1.8;
      rotate: -20deg;
    }
  }

  .sheet__not-yet {
    font: 400 17px/1 var(--font-hand);
    color: var(--pen);
  }

  .sheet__stack {
    margin-bottom: 8px;
    padding: 8px 0;
    border-block: 1px dashed var(--pencil);
    font: 400 14px/1.6 var(--font-mono);
    text-transform: lowercase;
  }

  .sheet__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: 400 20px/1 var(--font-hand);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: scale 0.1s var(--ease-settle);
  }

  .sheet__toggle:active {
    scale: 0.96;
  }

  .sheet__chevron {
    display: inline-block;
    transition: rotate 0.28s var(--ease-settle);
  }

  .sheet__toggle[aria-expanded="true"] .sheet__chevron {
    rotate: 180deg;
  }

  /* A slip of ruled paper; each line is written in, top to bottom. */
  .sheet__details {
    margin-top: 8px;
    padding: 4px 14px 8px;
    background-color: var(--paper);
    background-image: repeating-linear-gradient(
      transparent 0 31px,
      var(--rule-line) 31px 32px
    );
    animation: details-in 0.32s var(--ease-settle);
  }

  .sheet__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    min-height: 32px;
    align-items: baseline;
    padding-top: 6px;
    animation: write-in 0.36s var(--ease-settle) backwards;
  }

  .sheet__row:nth-child(2) {
    animation-delay: 50ms;
  }

  .sheet__row:nth-child(3) {
    animation-delay: 100ms;
  }

  .sheet__row:nth-child(4) {
    animation-delay: 150ms;
  }

  .sheet__row:nth-child(n + 5) {
    animation-delay: 200ms;
  }

  @keyframes details-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  @keyframes write-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  dt {
    flex: 0 0 130px;
    font: 700 14px/1.3 var(--font-mono);
    text-transform: lowercase;
  }

  dd {
    flex: 1 1 160px;
    font: 400 16px/1.6 var(--font-sans);
  }

  .sheet__repo {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 8px;
    min-height: 44px;
    margin-top: 8px;
    font: 400 14px/1.3 var(--font-mono);
  }

  .sheet__placeholder {
    color: var(--pencil);
  }
</style>
