---
import { content, tintVar } from "../data/content";
import PrintedShape from "./PrintedShape.astro";

const { volunteer } = content;

/** Each "Who" chip sits at its own slight tilt, like the stickers. */
const chipTilts = ["-1deg", "1deg", "-0.5deg"];

// Split a trailing "→" off the CTA label so it can nudge on hover.
const ctaMatch = /^(.*?)\s*→$/.exec(volunteer.cta.label);
const ctaText = ctaMatch?.[1] ?? volunteer.cta.label;
const ctaArrow = ctaMatch !== null;
---

<section id="volunteer" class="volunteer" aria-labelledby="h-vol">
  <div class="volunteer__card" data-fx="settle">
    <span class="sticker volunteer__sticker" data-fx="pop" data-delay="160">
      {volunteer.sticker}
    </span>

    <div class="volunteer__pin" aria-hidden="true">
      <PrintedShape fill="var(--soft-peach)" radius="50%" offset={4} size={52}>
        <span class="volunteer__pin-dot"></span>
      </PrintedShape>
    </div>

    <div class="volunteer__intro">
      <h2 id="h-vol" class="volunteer__title">
        {volunteer.title}
      </h2>
      <p class="volunteer__body">{volunteer.body}</p>
      <span class="kalam-note volunteer__note" aria-hidden="true">
        {volunteer.note}
      </span>
    </div>

    <div class="volunteer__details">
      <div class="volunteer__group">
        <h3 class="volunteer__label">{volunteer.whoLabel}</h3>
        <ul class="volunteer__who">
          {volunteer.who.map((w, i) => (
            <li
              style={`--chip-bg:${tintVar[w.tone]};--chip-tilt:${chipTilts[i % chipTilts.length]}`}
            >
              {w.label}
            </li>
          ))}
        </ul>
      </div>

      <div class="volunteer__group">
        <h3 class="volunteer__label">{volunteer.helpLabel}</h3>
        <ul class="volunteer__help">
          {volunteer.help.map((h) => (
            <li>
              <span class="volunteer__glyph" aria-hidden="true">
                {h.glyph}
              </span>
              {h.text}
            </li>
          ))}
        </ul>
      </div>

      <a class="volunteer__cta" href={volunteer.cta.href}>
        {ctaText}
        {ctaArrow && <span class="volunteer__cta-arrow">→</span>}
      </a>
    </div>
  </div>
</section>

<style>
  /* Bare page (like 03); no bottom padding, Contact supplies its own top. */
  .volunteer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-space) var(--block-pad-x) 0;
  }

  /* A pinned notice: dashed border sets it apart from the solid cards. */
  .volunteer__card {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 32px 56px;
    padding: clamp(28px, 4vw, 48px);
    background: var(--paper);
    border: 2.5px dashed var(--graphite);
    border-radius: 22px;
    rotate: -0.5deg;
  }

  .volunteer__sticker {
    left: clamp(20px, 4vw, 48px);
    top: -18px;
    padding: 8px 14px;
    font-size: 14px;
    background: var(--dusty-green);
    rotate: -3deg;
  }

  .volunteer__pin {
    position: absolute;
    right: clamp(20px, 4vw, 48px);
    top: -26px;
  }

  .volunteer__pin-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--graphite);
  }

  .volunteer__intro,
  .volunteer__details {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .volunteer__intro {
    gap: 16px;
  }

  .volunteer__details {
    gap: 22px;
  }

  .volunteer__title {
    max-width: 11ch;
    font: 800 clamp(44px, 6vw, 76px) / 0.88 var(--font-display);
    font-stretch: 78%;
    letter-spacing: -0.03em;
  }

  .volunteer__body {
    max-width: 40ch;
    font: clamp(18px, 1.7vw, 20px) / 1.5 var(--font-body);
  }

  .volunteer__note {
    align-self: flex-start;
    font-size: 22px;
    line-height: 1;
  }

  .volunteer__group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .volunteer__label {
    font: 700 14px/1 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .volunteer__who,
  .volunteer__help {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }

  .volunteer__who {
    flex-wrap: wrap;
    gap: 10px;
  }

  .volunteer__who li {
    padding: 10px 14px;
    background: var(--chip-bg);
    border: var(--border);
    border-radius: var(--radius-button);
    font: 700 16px/1.2 var(--font-body);
    rotate: var(--chip-tilt);
  }

  .volunteer__help {
    flex-direction: column;
    gap: 8px;
    font: 17px/1.4 var(--font-body);
  }

  .volunteer__help li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .volunteer__glyph {
    flex: none;
    font: 800 18px/1 var(--font-display);
  }

  .volunteer__cta {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 20px;
    background: var(--graphite);
    color: var(--cream);
    border: var(--border);
    border-radius: var(--radius-button-lg);
    box-shadow: 5px 5px 0 var(--dusty-green);
    font: 700 17px/1.2 var(--font-body);
    text-decoration: none;
    transition:
      transform 0.12s var(--ease-settle),
      box-shadow 0.12s var(--ease-settle);
  }

  .volunteer__cta:hover {
    color: var(--cream);
  }

  @media (hover: hover) {
    .volunteer__cta:hover {
      transform: translate(-2px, -2px);
      box-shadow: 7px 7px 0 var(--dusty-green);
    }

    .volunteer__cta:hover .volunteer__cta-arrow {
      translate: 3px 0;
    }
  }

  .volunteer__cta:active {
    transform: translate(5px, 5px);
    box-shadow: 0 0 0 var(--dusty-green);
  }

  .volunteer__cta-arrow {
    display: inline-block;
    transition: translate 0.2s var(--ease-settle);
  }
</style>
