---
/**
 * The volunteer flyer, taped to the page. Its call to action points down to
 * Contact's tear-off tabs (one of them drafts a volunteer project email).
 */
import { content, ui } from "../data/content";
import PageBreak from "./PageBreak.astro";
import Tape from "./Tape.astro";

const { volunteer } = content;

/** Hand-drawn ovals around the "who" words, each one a little different. */
const ovals = [
  { radius: "50% 46% 52% 44% / 60% 50% 56% 48%", tilt: -2 },
  { radius: "46% 54% 44% 52% / 52% 60% 46% 56%", tilt: 1.5 },
  { radius: "52% 44% 56% 48% / 48% 56% 50% 60%", tilt: -1 },
];
---

<section id="volunteer" class="section" aria-labelledby="h-vol">
  <PageBreak label={ui.tabs.volunteer} x={58} bg="var(--label)" />

  <div class="flyer" data-fx="settle">
    <Tape
      delay={300}
      place="left:-14px;top:-10px;width:90px;height:26px;rotate:-32deg"
    />
    <Tape
      delay={420}
      place="right:-14px;top:-10px;width:90px;height:26px;rotate:32deg;transform-origin:right center"
    />

    <div class="flyer__body grain">
      <p class="flyer__kicker">— {volunteer.kicker} —</p>
      <h2 id="h-vol" class="flyer__title">
        {volunteer.title}
      </h2>
      <p class="flyer__text">{volunteer.body}</p>
      <ul class="flyer__who">
        {volunteer.who.map((w, i) => {
          const o = ovals[i % ovals.length];
          return (
            <li
              data-fx="pop"
              data-delay={300 + i * 90}
              style={`border-radius:${o?.radius};rotate:${o?.tilt}deg`}
            >
              {w}
            </li>
          );
        })}
      </ul>
      <div class="flyer__help">
        <h3 class="flyer__label">{volunteer.helpLabel}</h3>
        <ul>
          {volunteer.help.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
      <a class="flyer__cta pen-note swipe" href="#tabs">
        {ui.volunteer.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .flyer {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    rotate: 1deg;
  }

  .flyer__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: clamp(28px, 4vw, 48px) clamp(20px, 4vw, 48px) 28px;
    background-color: var(--paper);
    box-shadow: var(--lift-sm);
    text-align: center;
  }

  .flyer__kicker {
    font: 700 14px/1 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .flyer__title {
    max-width: 12ch;
    font: 400 clamp(44px, 7vw, 84px) / 0.95 var(--font-hand);
    text-transform: uppercase;
  }

  .flyer__text {
    max-width: 40ch;
    font: 400 clamp(18px, 1.9vw, 21px) / 1.5 var(--font-sans);
  }

  .flyer__who {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    font: 800 18px/1.3 var(--font-sans);
  }

  .flyer__who li {
    padding: 8px 16px;
    border: 2.5px solid var(--ink);
  }

  .flyer__help {
    align-self: stretch;
    max-width: 520px;
    margin: 6px auto 0;
    text-align: left;
  }

  .flyer__help ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 0 0;
    padding-left: 22px;
    font: 400 18px/1.45 var(--font-sans);
  }

  .flyer__label {
    font: 700 13px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flyer__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 6px;
    rotate: -1.5deg;
    text-decoration: none;
  }

  .flyer__cta:hover {
    color: var(--pen);
  }

  .flyer__cta:active {
    translate: 0 2px;
  }
</style>
