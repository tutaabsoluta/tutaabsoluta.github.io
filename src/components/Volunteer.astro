---
/**
 * The volunteer flyer, stapled over an older one on the board. A photocopy:
 * black title band, a FREE! starburst, uneven toner, a curling corner. Its
 * call to action points down to Contact's tear-off tabs.
 */
import { content, ui } from "../data/content";
import BugFight from "./BugFight.astro";
import Doodle from "./Doodle.astro";
import PageBreak from "./PageBreak.astro";

const { volunteer } = content;

/** Hand-drawn ovals around the "who" words, each one a little different. */
const ovals = [
  { radius: "50% 46% 52% 44% / 60% 50% 56% 48%", tilt: -2 },
  { radius: "46% 54% 44% 52% / 52% 60% 46% 56%", tilt: 1.5 },
  { radius: "52% 44% 56% 48% / 48% 56% 50% 60%", tilt: -1 },
];
---

<section id="volunteer" class="section" aria-labelledby="h-vol">
  <PageBreak
    page={ui.pages.volunteer}
    label={ui.tabs.volunteer}
    x={58}
    bg="var(--label)"
  />

  <div class="flyer" data-fx="settle">
    <!-- Someone else's flyer underneath: all but one tab already taken. -->
    <div class="flyer__old grain" aria-hidden="true">
      <span class="flyer__old-title">{ui.volunteer.oldFlyer}</span>
      <span class="flyer__old-tabs">
        <span></span>
        <span></span>
        <span class="flyer__old-tab">;</span>
        <span></span>
        <span></span>
      </span>
    </div>
    <span class="staple staple--left" aria-hidden="true"></span>
    <span class="staple staple--right" aria-hidden="true"></span>
    <span
      class="flyer__badge"
      aria-hidden="true"
      data-fx="stamp"
      data-delay="520"
    >
      {ui.volunteer.badge}
    </span>

    <div class="flyer__body grain">
      <p class="flyer__kicker">— {volunteer.kicker} —</p>
      <h2 id="h-vol" class="flyer__title">
        {volunteer.title}
      </h2>
      <p class="flyer__text">{volunteer.body}</p>
      <ul class="flyer__who">
        {volunteer.who.map((w, i) => {
          const o = ovals[i % ovals.length];
          return (
            <li
              data-fx="pop"
              data-delay={300 + i * 90}
              style={`border-radius:${o?.radius};rotate:${o?.tilt}deg`}
            >
              {w}
            </li>
          );
        })}
      </ul>
      <div class="flyer__help">
        <h3 class="flyer__label">{volunteer.helpLabel}</h3>
        <ul>
          {volunteer.help.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
      <a class="flyer__cta pen-note swipe" href="#tabs">
        {ui.volunteer.cta}
      </a>
    </div>
  </div>
  <BugFight />
  <span
    class="scribble scribble--wide"
    aria-hidden="true"
    style="right:4%;bottom:calc(var(--section-space) + 120px);rotate:5deg;max-width:150px"
  >
    {ui.volunteer.scribble}
  </span>
  <Doodle
    kind="thumbs"
    wide
    size={66}
    delay={200}
    place="right:calc(4% + 30px);bottom:calc(var(--section-space) + 170px);rotate:6deg"
  />
</section>

<style>
  .flyer {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    rotate: 1deg;
  }

  /* The older flyer underneath, peeking out at the bottom left. */
  .flyer__old {
    position: absolute;
    inset: 40px 30px -46px -38px;
    background-color: var(--sheet-2);
    box-shadow: var(--lift-sm);
    rotate: -5deg;
    overflow: hidden;
  }

  .flyer__old-title {
    position: absolute;
    left: 14px;
    top: 30%;
    font: 400 40px/1 var(--font-hand);
    color: color-mix(in srgb, var(--ink) 55%, transparent);
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  /* Its tear-off strip: stubs, and one lonely tab left. */
  .flyer__old-tabs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 44px;
    display: flex;
    border-top: 1.5px dashed var(--pencil);
  }

  .flyer__old-tabs span {
    flex: 1;
    height: 8px;
    background: var(--sheet-2);
    clip-path: polygon(
      0 0,
      100% 0,
      100% 60%,
      80% 100%,
      55% 50%,
      30% 100%,
      0 60%
    );
  }

  .flyer__old-tabs .flyer__old-tab {
    height: 100%;
    display: grid;
    place-items: center;
    border-inline: 1.5px dashed var(--pencil);
    font: 700 16px/1 var(--font-mono);
    clip-path: none;
  }

  /* Staples holding it to the board. */
  .staple {
    position: absolute;
    z-index: 3;
    top: 12px;
    width: 34px;
    height: 5px;
    border: 1.5px solid var(--pencil);
    border-radius: 2px;
    background: linear-gradient(var(--hole), var(--perforation));
  }

  .staple--left {
    left: 22px;
    rotate: -8deg;
  }

  .staple--right {
    right: 22px;
    rotate: 6deg;
  }

  /* The FREE! starburst every community flyer has. */
  .flyer__badge {
    position: absolute;
    z-index: 3;
    right: clamp(4px, 1vw, 8px);
    top: clamp(36px, 6vw, 60px);
    width: clamp(64px, 11vw, 104px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--highlighter);
    font: 400 clamp(18px, 2.4vw, 24px) / 1 var(--font-hand);
    text-transform: uppercase;
    rotate: 14deg;
    clip-path: polygon(
      50% 0,
      61% 15%,
      79% 7%,
      80% 26%,
      98% 30%,
      88% 47%,
      100% 62%,
      82% 70%,
      84% 90%,
      65% 85%,
      52% 100%,
      40% 86%,
      21% 94%,
      19% 74%,
      0 68%,
      11% 51%,
      2% 33%,
      20% 27%,
      20% 8%,
      38% 14%
    );
  }

  .flyer__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: clamp(28px, 4vw, 48px) clamp(20px, 4vw, 48px) 28px;
    /* A photocopy: uneven toner, darker at the edges, one faint streak,
       and a printed frame. */
    background:
      linear-gradient(
        90deg,
        transparent 71%,
        rgb(26 26 26 / 0.035) 71% 73.5%,
        transparent 73.5%
      ),
      radial-gradient(
        ellipse at 50% 45%,
        transparent 55%,
        rgb(26 26 26 / 0.07) 100%
      ),
      var(--grain), var(--paper);
    box-shadow:
      inset 0 0 0 10px var(--paper),
      inset 0 0 0 12.5px var(--ink),
      var(--lift);
    text-align: center;
  }

  /* The bottom corner has started to curl off the board. */
  .flyer__body::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46px;
    height: 46px;
    background: linear-gradient(
      315deg,
      var(--page) 0 50%,
      var(--sheet-2) 50% 70%,
      var(--paper) 100%
    );
    filter: drop-shadow(-2px -2px 2px rgb(26 26 26 / 0.12));
  }

  .flyer__kicker {
    font: 700 14px/1 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Printed white on a black band, the way photocopied flyers shout. */
  .flyer__title {
    padding: 4px 18px 8px;
    background: var(--ink);
    color: var(--paper);
    rotate: -1deg;
    max-width: 100%;
    font: 400 clamp(32px, 7vw, 84px) / 0.95 var(--font-hand);
    text-transform: uppercase;
  }

  .flyer__text {
    max-width: 40ch;
    font: 400 clamp(18px, 1.9vw, 21px) / 1.5 var(--font-sans);
  }

  .flyer__who {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    font: 800 18px/1.3 var(--font-sans);
  }

  .flyer__who li {
    padding: 8px 16px;
    border: 2.5px solid var(--ink);
  }

  .flyer__help {
    align-self: stretch;
    max-width: 520px;
    margin: 6px auto 0;
    text-align: left;
  }

  .flyer__help ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 0 0;
    padding-left: 22px;
    font: 400 18px/1.45 var(--font-sans);
  }

  .flyer__label {
    font: 700 13px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flyer__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 6px;
    rotate: -1.5deg;
    text-decoration: none;
  }

  .flyer__cta:hover {
    color: var(--pen);
  }

  .flyer__cta:active {
    translate: 0 2px;
  }

  /* Phones: the badge sits in the top corner (clear of the title), the
     curl and the older flyer shrink, and the CTA keeps clear of the curl. */
  @media (max-width: 599.98px) {
    .flyer__badge {
      top: -18px;
      right: 2px;
      font-size: 15px;
    }

    .flyer__body {
      padding-bottom: 44px;
    }

    .flyer__body::after {
      width: 30px;
      height: 30px;
    }

    .flyer__old {
      inset: 30px 14px -40px -10px;
      rotate: -3deg;
    }

    .flyer__old-title {
      display: none;
    }
  }
</style>
