---
/** A few rolled-up eraser crumbs left on the page. Decorative. */
interface Props {
  place: string;
  wide?: boolean;
}

const { place, wide = false } = Astro.props;

/** [x, y, rotate, scale] for each crumb. */
const crumbs: [number, number, number, number][] = [
  [4, 18, 10, 1],
  [16, 6, -30, 0.8],
  [28, 22, 60, 1.2],
  [40, 10, 15, 0.7],
  [52, 26, -45, 0.9],
  [22, 34, 80, 0.6],
  [62, 14, 30, 1],
];
---

<svg
  class:list={["crumbs", { "crumbs--wide": wide }]}
  aria-hidden="true"
  viewBox="0 0 76 44"
  width="118"
  height="68"
  style={place}
>
  {crumbs.map(([x, y, r, k]) => (
    <path
      transform={`translate(${x} ${y}) rotate(${r}) scale(${k})`}
      d="M0 0 C 2 -3, 6 -3, 7 0 C 8 3, 5 4, 3 3 C 1 2, 2 0, 4 1"
    />
  ))}
</svg>

<style>
  .crumbs {
    position: absolute;
    overflow: visible;
    fill: var(--crumb);
    stroke: var(--crumb-edge);
    stroke-width: 0.8;
    pointer-events: none;
  }

  @media (max-width: 899.98px) {
    .crumbs--wide {
      display: none;
    }
  }
</style>
