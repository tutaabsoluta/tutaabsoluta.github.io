---
import { content, linkAttrs, linkByKind, ui } from "../data/content";
import CiStatus from "./CiStatus.astro";
import Doodle from "./Doodle.astro";
import PageBreak from "./PageBreak.astro";
import TearTabs from "./TearTabs.astro";

const { contact, person } = content;
const links = contact.order.map((kind) => linkByKind(kind));

// "Let's talk." → "Let's" / "talk" + a full stop in pen.
const words = contact.title.replace(/\.$/, "").split(" ");
const stop = contact.title.endsWith(".");

/** Zig-zag top and bottom edges, like a slip torn off a receipt roll. */
const zigzag = (() => {
  const top: string[] = [];
  const bottom: string[] = [];
  for (let i = 0; i <= 20; i++) {
    const x = i * 5;
    top.push(`${x}% ${i % 2 ? 0 : 3}%`);
    bottom.unshift(`${x}% ${i % 2 ? 100 : 97}%`);
  }
  return `polygon(${[...top, ...bottom].join(",")})`;
})();
---

<section id="contact" class="section contact" aria-labelledby="h-contact">
  <PageBreak
    page={ui.pages.contact}
    label={ui.tabs.contact}
    x={76}
    bg="var(--highlighter)"
  />

  <div class="contact__row">
    <div class="contact__words">
      <p class="mono-kicker contact__kicker">{ui.contact.kicker}</p>
      <h2 id="h-contact" class="contact__title" data-fx="settle">
        {words.map((word, i) => (
          <>
            {i > 0 && <br />}
            {word}
          </>
        ))}
        {stop && <span class="contact__stop">.</span>}
      </h2>
      <p class="contact__line">{contact.line}</p>
    </div>

    <div class="slip-wrap" data-fx="settle" data-delay="140">
      <svg class="paperclip" aria-hidden="true" viewBox="0 0 26 70" fill="none">
        <path d="M9 22 V54 a6 6 0 0 0 12 0 V14 a9 9 0 0 0 -18 0 V50"></path>
      </svg>
      <div class="slip grain" style={`clip-path:${zigzag}`}>
        <p class="slip__note">{contact.note}</p>
        <ul class="slip__links">
          {links.map((l, i) => (
            <li>
              <a
                class="slip__link swipe"
                href={l.href}
                {...linkAttrs(l.href)}
                data-fx="fade"
                data-delay={280 + i * 90}
              >
                <b class="slip__kind">{l.kind}</b>
                <span class="slip__label">
                  {l.label} <span class="slip__arrow">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <Doodle
    kind="bike"
    wide
    size={50}
    delay={300}
    place="right:calc(var(--gutter) + 6px);top:118px;rotate:-6deg"
  />
  <span
    class="scribble scribble--wide"
    aria-hidden="true"
    style="right:calc(var(--gutter) + 70px);top:128px;rotate:-4deg;text-align:right"
  >
    {ui.contact.bikeNote[0]}
    <br />
    {ui.contact.bikeNote[1]}
  </span>

  <TearTabs />

  <footer class="footer">
    <span>{ui.footer.madeBy(person.name, person.location)}</span>
    <CiStatus />
    <a class="footer__top swipe" href="#intro">
      {ui.footer.backToTop}
    </a>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 40px;
  }

  .contact__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }

  .contact__words {
    position: relative;
  }

  .contact__kicker {
    margin-bottom: 14px;
  }

  .contact__title {
    font: 800 clamp(80px, 15vw, 220px) / 0.8 var(--font-sans);
    letter-spacing: -0.06em;
    text-transform: lowercase;
  }

  .contact__stop {
    display: inline-block;
    color: var(--pen);
  }

  /* The full stop gets pressed in, a beat after the title lands. */
  .fx [data-fx-done] .contact__stop {
    animation: stop-in 0.35s var(--ease-stamp) 0.45s backwards;
  }

  @keyframes stop-in {
    from {
      opacity: 0;
      scale: 2.4;
    }
  }

  .contact__line {
    margin-top: 24px;
    font: 400 15px/1.4 var(--font-mono);
    text-transform: lowercase;
  }

  .slip-wrap {
    position: relative;
    flex: 0 1 440px;
    min-width: min(100%, 300px);
    rotate: -1.2deg;
    transition: rotate 0.25s var(--ease-settle);
  }

  @media (hover: hover) {
    .slip-wrap:hover {
      rotate: -0.4deg;
    }
  }

  .slip {
    padding: 22px 24px;
    background-color: var(--paper);
    box-shadow: var(--lift-sm);
  }

  /* A paperclip holding the slip (outside it, so the zig-zag doesn't cut it). */
  .paperclip {
    position: absolute;
    z-index: 2;
    left: 34px;
    top: -30px;
    width: 26px;
    height: 70px;
    stroke: var(--pencil);
    stroke-width: 2.5;
    stroke-linecap: round;
    rotate: 8deg;
  }

  .slip__note {
    margin: 10px 0 14px;
    font: 400 20px/1 var(--font-hand);
  }

  .slip__links {
    list-style: none;
    margin: 0;
    padding: 0;
    font: 400 16px/1.3 var(--font-mono);
  }

  .slip__links li + li {
    border-top: 1px dashed var(--pencil);
  }

  .slip__link {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2px 12px;
    min-height: 52px;
    padding: 0 4px;
    text-decoration: none;
    transition:
      background-size 0.16s var(--ease-settle),
      scale 0.1s var(--ease-settle);
  }

  .slip__link:active {
    scale: 0.98;
  }

  .slip__kind {
    text-transform: lowercase;
  }

  .slip__label {
    margin-left: auto;
    overflow-wrap: anywhere;
    text-align: right;
  }

  .slip__arrow {
    display: inline-block;
    transition: translate 0.2s var(--ease-settle);
  }

  @media (hover: hover) {
    .slip__link:hover .slip__arrow {
      translate: 4px 0;
    }
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 64px;
    font: 400 13px/1.4 var(--font-mono);
    color: var(--pencil);
    text-transform: lowercase;
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }
</style>
