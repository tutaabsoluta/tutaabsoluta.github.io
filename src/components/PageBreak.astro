---
/**
 * The top of every section after the intro: a hand-labelled divider tab
 * poking up from a perforated, hole-punched line, like a notebook divider.
 * Decorative (the section's h2 carries the name).
 */
interface Props {
  label: string;
  /** Left position of the tab, as a percentage of the row. */
  x: number;
  /** Tab colour (CSS value). */
  bg: string;
}

const { label, x, bg } = Astro.props;
---

<div class="page-break" aria-hidden="true">
  <span class="page-break__tab" data-fx="rise" style={`--x:${x}%;--tab:${bg}`}>
    {label}
  </span>
  <span class="page-break__perforation"></span>
  <span class="page-break__holes"></span>
</div>

<style>
  .page-break {
    position: relative;
    height: 64px;
    margin: 0 0 clamp(24px, 4vw, 40px);
  }

  .page-break__tab {
    position: absolute;
    left: min(var(--x), calc(100% - 190px));
    top: 0;
    height: 32px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    background: var(--tab);
    border: 1.5px solid var(--perforation);
    border-bottom: 0;
    font: 400 16px/1 var(--font-hand);
    text-transform: lowercase;
    white-space: nowrap;
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
  }

  .page-break__perforation {
    position: absolute;
    left: 0;
    right: 0;
    top: 31px;
    border-top: 2px dashed var(--perforation);
  }

  .page-break__holes {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    height: 22px;
    background: radial-gradient(
        circle,
        var(--hole) 0 5px,
        var(--perforation) 5px 6.5px,
        transparent 7px
      )
      0 50% / 36px 22px repeat-x;
  }
</style>
