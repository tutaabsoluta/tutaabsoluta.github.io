---
/**
 * The top of every section after the intro: a hand-labelled divider tab
 * poking up from a perforated line, like a notebook divider,
 * plus the page's "no. __ · date ____" header. Decorative (the section's h2
 * carries the name).
 */
import { ui } from "../data/content";

interface Props {
  label: string;
  /** Left position of the tab, as a percentage of the row. */
  x: number;
  /** Tab colour (CSS value). */
  bg: string;
  /** Notebook page number. */
  page: string;
}

const { label, x, bg, page } = Astro.props;
// The page header sits on the side the tab isn't.
const metaSide = x > 50 ? "left" : "right";
---

<div class="page-break" aria-hidden="true">
  <span class="page-break__tab" data-fx="rise" style={`--x:${x}%;--tab:${bg}`}>
    {label}
  </span>
  <span class={`page-break__meta page-break__meta--${metaSide}`}>
    {ui.pageNo(page)} · {ui.pageDate}
    <span class="page-break__blank"></span>
  </span>
  <span class="page-break__perforation"></span>
</div>

<style>
  .page-break {
    position: relative;
    height: 34px;
    margin: 0 0 clamp(36px, 5vw, 56px);
  }

  .page-break__tab {
    position: absolute;
    /* At X% of the row, shifted back by X% of its own width: the tab
       always stays inside the row, however long the label is. */
    left: var(--x);
    translate: calc(var(--x) * -1) 0;
    top: 0;
    height: 32px;
    padding: 0 24px;
    display: flex;
    align-items: center;
    background: var(--tab);
    border: 1.5px solid var(--perforation);
    border-bottom: 0;
    font: 400 16px/1 var(--font-hand);
    text-transform: lowercase;
    white-space: nowrap;
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
  }

  .page-break__meta {
    position: absolute;
    top: 6px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    font: 400 12px/1 var(--font-mono);
    color: var(--pencil);
  }

  .page-break__meta--left {
    left: 0;
  }

  .page-break__meta--right {
    right: 0;
  }

  .page-break__blank {
    width: 72px;
    border-bottom: 1px solid var(--pencil);
  }

  @media (max-width: 899.98px) {
    .page-break__meta {
      display: none;
    }
  }

  .page-break__perforation {
    position: absolute;
    left: 0;
    right: 0;
    top: 31px;
    border-top: 2px dashed var(--perforation);
  }
</style>
