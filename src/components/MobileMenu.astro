---
import { ui } from "../data/content";

const items = [...ui.nav, ui.navContact];
---

<nav id="mobile-menu" class="mobile-menu" aria-label="Main" hidden>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} data-menu-link>
          <span>{item.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .mobile-menu {
    position: relative;
    z-index: 20;
    margin: 0 20px 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--paper);
    border: var(--border);
    border-radius: var(--radius-card-sm);
    box-shadow: 5px 5px 0 var(--lavender);
    transform-origin: top right;
    animation: menu-drop 0.3s var(--ease-settle);
  }

  /* Replays each time `hidden` is lifted: the card drops from the toggle,
     then the links follow. */
  @keyframes menu-drop {
    from {
      opacity: 0;
      translate: 0 -10px;
      rotate: -1.5deg;
    }
  }

  li {
    animation: menu-item-in 0.28s var(--ease-settle) backwards;
  }

  li:nth-child(2) {
    animation-delay: 30ms;
  }

  li:nth-child(3) {
    animation-delay: 60ms;
  }

  li:nth-child(4) {
    animation-delay: 90ms;
  }

  li:nth-child(n + 5) {
    animation-delay: 120ms;
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }

  a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 10px;
    font: 800 20px/1 var(--font-display);
    color: var(--graphite);
    text-decoration: none;
    transition: background-color 0.15s;
  }

  a:hover {
    background: var(--cream);
  }

  a span:last-child {
    transition: translate 0.2s var(--ease-settle);
  }

  @media (hover: hover) {
    a:hover span:last-child {
      translate: 3px 0;
    }
  }

  @media (min-width: 760px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
