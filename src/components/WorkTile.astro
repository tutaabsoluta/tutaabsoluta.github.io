---
import { shapeRadius, tintVar, ui, type WorkTile } from "../data/content";
import PrintedShape from "./PrintedShape.astro";

interface Props {
  tile: WorkTile;
  index: number;
}

const { tile: t, index } = Astro.props;
const rotations = [
  "-0.6deg",
  "0.6deg",
  "0.4deg",
  "-0.4deg",
  "0.5deg",
  "-0.5deg",
  "0.4deg",
  "-0.4deg",
];
const rot = rotations[index % rotations.length] ?? "0deg";
const detailId = `work-${t.id}-detail`;
const originalId = `work-${t.id}-original`;
---

<li
  id={`work-${t.id}`}
  class="tile"
  data-fx="settle"
  data-delay={(index % 4) * 70}
  style={`--tint:${tintVar[t.tone]};--rot:${rot}`}
>
  <div class="tile__top">
    <PrintedShape
      size={44}
      offset={4}
      fill="var(--paper)"
      radius={shapeRadius[t.shape]}
      glyph={t.glyph}
      glyphSize={20}
    />
    <button
      type="button"
      class="tile__toggle"
      aria-expanded="false"
      aria-controls={`${detailId} ${originalId}`}
      aria-label={`${ui.experience.showFull} ${t.title}`}
      data-flip
      data-label-show={`${ui.experience.showFull} ${t.title}`}
      data-label-hide={`${ui.experience.hideFull} ${t.title}`}
    >
      <span class="tile__sign" aria-hidden="true"></span>
    </button>
  </div>
  <h3 class="tile__title">{t.title}</h3>
  <p id={detailId} class="tile__detail">
    {t.detail}
  </p>
  <p id={originalId} class="tile__original" hidden>
    {t.original}
  </p>
</li>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
    padding: 18px;
    background: var(--tint);
    border: var(--border);
    border-radius: var(--radius-card-sm);
    rotate: var(--rot);
    transition:
      rotate 0.2s var(--ease-settle),
      translate 0.2s var(--ease-settle),
      box-shadow 0.3s;
  }

  @media (hover: hover) {
    .tile:hover {
      rotate: 0deg;
      translate: 0 -3px;
    }
  }

  .tile[data-flash] {
    box-shadow: 0 0 0 4px var(--ink-blue);
    animation: tile-wiggle 0.5s var(--ease-settle);
  }

  /* One nudge when a "Seen in" chip lands here. */
  @keyframes tile-wiggle {
    25% {
      rotate: -2deg;
    }
    55% {
      rotate: 1.5deg;
    }
    80% {
      rotate: -0.5deg;
    }
  }

  .tile__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .tile__toggle {
    width: 44px;
    height: 44px;
    margin: -6px -6px 0 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile__sign {
    position: relative;
    width: 30px;
    height: 30px;
    border: 2px solid var(--graphite);
    border-radius: 50%;
    transition:
      background-color 0.2s,
      scale 0.15s var(--ease-settle);
  }

  /* Two bars draw the sign; the vertical one rotates flat to become "−". */
  .tile__sign::before,
  .tile__sign::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 2.5px;
    border-radius: 1px;
    background: currentColor;
  }

  .tile__sign::after {
    rotate: 90deg;
    transition: rotate 0.28s var(--ease-settle);
  }

  .tile__toggle:active .tile__sign {
    scale: 0.9;
  }

  .tile__toggle[aria-expanded="true"] .tile__sign {
    background: var(--paper);
  }

  .tile__toggle[aria-expanded="true"] .tile__sign::after {
    rotate: 180deg;
  }

  /* Replays each time `hidden` is lifted, so the swapped-in text eases up. */
  .tile__detail,
  .tile__original {
    animation: tile-text-in 0.32s var(--ease-settle);
  }

  @keyframes tile-text-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  .tile__title {
    font: 800 22px/1.05 var(--font-display);
    font-stretch: 88%;
  }

  .tile__detail {
    margin-top: auto;
    font: 15px/1.4 var(--font-body);
  }

  .tile__original {
    font: 15px/1.5 var(--font-body);
    background: var(--paper);
    border: 2px solid var(--graphite);
    border-radius: 10px;
    padding: 10px 12px;
  }
</style>
