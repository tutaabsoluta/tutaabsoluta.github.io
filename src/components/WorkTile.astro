---
/**
 * One line of the experience log: glyph, highlighted title, short detail, and
 * a +/− toggle that unfolds the original CV wording underneath.
 */
import {
  shapeRadius,
  toneVar,
  ui,
  type TintTone,
  type Tone,
  type WorkTile,
} from "../data/content";
import PrintedShape from "./PrintedShape.astro";

interface Props {
  tile: WorkTile;
}

const { tile: t } = Astro.props;

/** The log sits on paper, so each pale tint uses its stronger tone. */
const markTone: Record<TintTone, Tone> = {
  greenTint: "green",
  peachTint: "peach",
  blueTint: "blue",
  lavenderTint: "lavender",
};
const originalId = `work-${t.id}-original`;
---

<li
  id={`work-${t.id}`}
  class="entry"
  style={`--tone:${toneVar[markTone[t.tone]]}`}
>
  <PrintedShape
    class="entry__glyph"
    size={44}
    offset={4}
    fill="var(--tone)"
    radius={shapeRadius[t.shape]}
    glyph={t.glyph}
    glyphSize={20}
  />
  <h3 class="entry__title">
    <span class="entry__mark">{t.title}</span>
  </h3>
  <p class="entry__detail">{t.detail}</p>
  <a class="entry__back" href="#how" hidden data-back>
    <span aria-hidden="true">← </span>{ui.experience.backToHow}
  </a>
  <button
    type="button"
    class="entry__toggle"
    aria-expanded="false"
    aria-controls={originalId}
    aria-label={`${ui.experience.showFull} ${t.title}`}
    data-flip
    data-label-show={`${ui.experience.showFull} ${t.title}`}
    data-label-hide={`${ui.experience.hideFull} ${t.title}`}
  >
    <span class="entry__sign" aria-hidden="true"></span>
  </button>
  <p id={originalId} class="entry__original" hidden>
    {t.original}
  </p>
</li>

<style>
  /* Narrow (default): glyph, title over detail, toggle */
  .entry {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    grid-template-areas:
      "glyph title toggle"
      "glyph detail toggle"
      ". back back"
      ". original original";
    align-items: start;
    gap: 0 14px;
    padding: 16px clamp(14px, 2.4vw, 24px);
    border-bottom: 2px dashed var(--graphite);
    transition: box-shadow 0.3s;
  }

  .entry:last-child {
    border-bottom: 0;
  }

  .entry :global(.entry__glyph) {
    grid-area: glyph;
  }

  .entry__title {
    grid-area: title;
    align-self: center;
    font: 800 21px/1.15 var(--font-display);
    font-stretch: 88%;
  }

  /* Highlighter stroke under the title, in the entry's tone. */
  .entry__mark {
    padding: 0 3px;
    background: linear-gradient(var(--tone), var(--tone)) left bottom / 100%
      40% no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.25s var(--ease-settle);
  }

  .entry__detail {
    grid-area: detail;
    margin-top: 6px;
    font: 15px/1.4 var(--font-body);
    color: var(--text-muted);
  }

  .entry__toggle {
    grid-area: toggle;
    align-self: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .entry__sign {
    position: relative;
    width: 30px;
    height: 30px;
    border: 2px solid var(--graphite);
    border-radius: 50%;
    transition:
      background-color 0.2s,
      scale 0.15s var(--ease-settle);
  }

  /* Two bars draw the sign; the vertical one rotates flat to become "−". */
  .entry__sign::before,
  .entry__sign::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 2.5px;
    border-radius: 1px;
    background: currentColor;
  }

  .entry__sign::after {
    rotate: 90deg;
    transition: rotate 0.28s var(--ease-settle);
  }

  .entry__toggle:active .entry__sign {
    scale: 0.9;
  }

  .entry__toggle[aria-expanded="true"] .entry__sign {
    background: var(--tone);
  }

  .entry__toggle[aria-expanded="true"] .entry__sign::after {
    rotate: 180deg;
  }

  /* Shown after a "Seen in" jump; returns to the stage that linked here. */
  .entry__back {
    grid-area: back;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 2px;
    font: 700 20px/1 var(--font-note);
    color: var(--ink-blue);
    text-decoration: none;
    rotate: -1.5deg;
    animation: entry-text-in 0.32s var(--ease-settle) 0.2s backwards;
  }

  .entry__back:hover {
    color: var(--ink-blue);
    text-decoration: underline;
  }

  .entry__original {
    grid-area: original;
    max-width: 68ch;
    margin-top: 10px;
    padding-left: 12px;
    border-left: 3px solid var(--tone);
    font: 15px/1.55 var(--font-body);
    color: var(--text-body);
    /* Replays each time `hidden` is lifted. */
    animation: entry-text-in 0.32s var(--ease-settle);
  }

  @keyframes entry-text-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  @media (hover: hover) {
    .entry:hover .entry__mark {
      background-size: 100% 100%;
    }

    .entry:hover {
      --printed-align: 1;
    }
  }

  /* A "Seen in" chip landed here: ring the line and redraw the highlight. */
  .entry[data-flash] {
    box-shadow: inset 0 0 0 3px var(--ink-blue);
  }

  .entry[data-flash] .entry__mark {
    animation: mark-sweep 0.6s var(--ease-settle);
  }

  @keyframes mark-sweep {
    from {
      background-size: 0% 40%;
    }
  }

  /* Wide: a ledger line — glyph, title, detail, toggle in one row */
  @media (min-width: 820px) {
    .entry {
      grid-template-columns: 44px minmax(0, 1.15fr) minmax(0, 1fr) 44px;
      grid-template-areas:
        "glyph title detail toggle"
        ". back back ."
        ". original original .";
      align-items: center;
      gap: 0 24px;
    }

    .entry__detail {
      align-self: center;
      margin-top: 0;
    }
  }
</style>
