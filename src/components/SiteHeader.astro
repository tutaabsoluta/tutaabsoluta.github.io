---
import { ui } from "../data/content";
import MobileMenu from "./MobileMenu.astro";
---

<header class="site-header">
  <a class="site-header__brand swipe" href="#intro">{ui.brand}</a>

  <nav class="site-header__nav" aria-label="Main">
    <ul>
      {ui.nav.map((item) => (
        <li>
          <a class="nav-link swipe" href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a class="nav-link nav-link--contact swipe" href={ui.navContact.href}>
          {ui.navContact.label}
          <span class="nav-link__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </nav>

  <button
    type="button"
    class="menu-toggle"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-toggle
    data-label-open={ui.menuOpen}
    data-label-close={ui.menuClose}
  >
    {ui.menuOpen}
  </button>
</header>
<MobileMenu />

<style>
  .site-header {
    position: relative;
    z-index: 20;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    font: 400 14px/1.4 var(--font-mono);
    border-bottom: 1.5px solid var(--pencil);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 2px;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 2px;
    text-transform: lowercase;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  .nav-link--contact {
    font-weight: 700;
  }

  .nav-link__arrow {
    display: inline-block;
    transition: translate 0.2s var(--ease-settle);
  }

  @media (hover: hover) {
    .nav-link--contact:hover .nav-link__arrow {
      translate: 4px 0;
    }
  }

  .nav-link:active,
  .site-header__brand:active {
    translate: 0 1px;
  }

  /* A pencilled box with a hand-drawn wobble. */
  .menu-toggle {
    display: none;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--ink);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: var(--paper);
    font: 700 14px/1 var(--font-mono);
    text-transform: lowercase;
    cursor: pointer;
    rotate: 1.5deg;
    transition:
      rotate 0.2s var(--ease-settle),
      scale 0.1s var(--ease-settle);
  }

  .menu-toggle[aria-expanded="true"] {
    rotate: -1.5deg;
    background: var(--highlighter);
  }

  .menu-toggle:active {
    scale: 0.94;
  }

  @media (max-width: 759.98px) {
    .site-header__nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }
</style>
