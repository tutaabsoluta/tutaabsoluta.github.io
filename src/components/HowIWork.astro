---
import { content, ui } from "../data/content";
import Crumbs from "./Crumbs.astro";
import PageBreak from "./PageBreak.astro";
import Tape from "./Tape.astro";

const { howIWork } = content;
/** Hand-drawn circles never come out the same twice. */
const circles = [
  "M22 4 C 36 3, 42 14, 40 24 C 38 34, 26 39, 16 36 C 6 33, 2 22, 5 13 C 8 6, 16 3, 27 5",
  "M20 5 C 32 2, 41 11, 40 21 C 39 32, 29 38, 18 37 C 8 35, 3 26, 4 16 C 6 8, 14 3, 25 4",
  "M24 3 C 35 4, 42 15, 39 25 C 36 35, 24 39, 14 35 C 5 31, 2 20, 6 12 C 10 5, 18 2, 28 6",
];
---

<section id="how" class="section" aria-labelledby="h-how">
  <PageBreak page={ui.pages.how} label={ui.tabs.how} x={40} bg="var(--paper)" />
  <div class="section-head">
    <p class="mono-kicker">{ui.how.kicker}</p>
    <h2 id="h-how" class="display-h2" data-fx="settle">
      {ui.how.title}
    </h2>
  </div>

  <div class="notebook grain" data-fx="settle">
    <Tape
      delay={260}
      place="left:50%;top:-14px;width:130px;height:30px;margin-left:-65px;rotate:-2deg"
    />
    <svg
      class="coffee"
      aria-hidden="true"
      viewBox="0 0 160 160"
      data-fx="fade"
      data-delay="500"
    >
      <circle
        cx="80"
        cy="80"
        r="62"
        stroke-width="7"
        stroke-dasharray="180 6 90 4 60 10 40"
      ></circle>
      <circle
        cx="81"
        cy="78"
        r="55"
        stroke-width="2"
        stroke-dasharray="120 30 60 40"
      ></circle>
      <path
        d="M128 118 c 8 6, 14 10, 12 18 c -2 6, -10 4, -9 -3"
        stroke-width="5"
      ></path>
    </svg>
    <p class="notebook__intro">{howIWork.intro}</p>
    <p
      class="notebook__hint pen-note"
      aria-hidden="true"
      data-fx="fade"
      data-delay="700"
      data-narrow="(max-width: 1099.98px)"
      data-fx-narrow="none"
    >
      {ui.how.hint[0]}
      <br />
      {ui.how.hint[1]}
      <svg viewBox="0 0 60 70" fill="none">
        <path
          data-draw
          data-delay="900"
          data-narrow="(max-width: 1099.98px)"
          data-fx-narrow="none"
          pathLength="1"
          d="M10 4 C 40 10, 50 30, 40 60"
        ></path>
        <path d="M31 52 L40 62 L48 50"></path>
      </svg>
    </p>
    <ol class="steps">
      {howIWork.stages.map((s, i) => (
        <li
          id={`stage-${s.n}`}
          class="step"
          style={`--tilt:${i % 2 ? 4 : -5}deg`}
        >
          <span class="step__n">
            <svg class="step__circle" aria-hidden="true" viewBox="0 0 44 40">
              <path
                data-draw
                data-delay={i * 90}
                pathLength="1"
                d={circles[i % circles.length]}
              />
            </svg>
            <span class="visually-hidden">{ui.how.stage} </span>
            {Number(s.n)}
          </span>
          <h3 class="step__name">{s.name}</h3>
          <p class="step__what">{s.what}</p>
          <p class="step__seen">
            <span aria-hidden="true">↳ </span>
            {s.seen.map((x, j) => (
              <>
                {j > 0 && <span aria-hidden="true"> + </span>}
                <a
                  class="step__link swipe"
                  href={`#work-${x.tile}`}
                  data-flash-target={`work-${x.tile}`}
                >
                  {x.label}
                </a>
              </>
            ))}
          </p>
        </li>
      ))}
    </ol>
  </div>
  <Crumbs wide place="right:calc(var(--gutter) + 10px);bottom:60px" />
</section>

<style>
  /* One notebook page: a vertical margin line and ruled lines. */
  .notebook {
    --margin: clamp(44px, 7vw, 84px);
    position: relative;
    padding: 28px clamp(16px, 3vw, 40px) 36px clamp(56px, 9vw, 108px);
    background-color: var(--paper);
    background-image:
      linear-gradient(
        90deg,
        transparent 0 var(--margin),
        var(--margin-line) var(--margin) calc(var(--margin) + 2px),
        transparent 0
      ),
      repeating-linear-gradient(transparent 0 35px, var(--rule-line) 35px 36px);
    box-shadow:
      1px 2px 0 rgb(26 26 26 / 0.16),
      0 18px 30px -22px rgb(26 26 26 / 0.5);
    rotate: -0.6deg;
  }

  /* Torn out of a spiral notebook: the ring holes along the top edge. */
  .notebook::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 16px;
    background: radial-gradient(
        circle at 50% 70%,
        var(--page) 0 4.5px,
        transparent 5px
      )
      6px 0 / 26px 16px repeat-x;
  }

  .coffee {
    position: absolute;
    left: -46px;
    bottom: -52px;
    width: 160px;
    height: 160px;
    z-index: 2;
    fill: none;
    stroke: var(--coffee);
    stroke-linecap: round;
    mix-blend-mode: multiply;
    rotate: 20deg;
    pointer-events: none;
  }

  /* A pen note pointing at the "↳" links (desktop, where they line up). */
  .notebook__hint {
    position: absolute;
    right: clamp(24px, 6vw, 72px);
    top: 34px;
    font-size: 18px;
    rotate: 3deg;
    text-align: right;
  }

  .notebook__hint svg {
    width: 44px;
    height: 52px;
    margin: 2px 6px 0 auto;
    stroke: var(--pen);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 1099.98px) {
    .notebook__hint {
      display: none;
    }
  }

  .notebook__intro {
    max-width: 30ch;
    margin-bottom: 28px;
    font: 400 clamp(22px, 2.4vw, 28px) / 1.3 var(--font-hand);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px dashed var(--perforation);
    scroll-margin-top: 40px;
  }

  .step__n {
    position: relative;
    flex: 0 0 auto;
    width: 44px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 400 22px/1 var(--font-hand);
    rotate: var(--tilt);
  }

  .step__circle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: -1;
    fill: transparent;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    transition: fill 0.2s;
  }

  @media (hover: hover) {
    .step:hover .step__circle {
      fill: var(--highlighter);
    }
  }

  .step__name {
    flex: 0 0 200px;
    font: 800 clamp(26px, 2.6vw, 34px) / 1 var(--font-sans);
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .step__what {
    flex: 1 1 260px;
    font: 400 18px/1.5 var(--font-sans);
  }

  .step__seen {
    flex: 0 1 260px;
    font: 400 17px/1.6 var(--font-hand);
    color: var(--pen);
    rotate: -1.5deg;
  }

  /* Inline, so it wraps with the ↳; padding gives a 44px tap target. */
  .step__link {
    padding: 12px 0;
    color: var(--pen);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .step__link:hover {
    color: var(--ink);
  }

  .step__link:active {
    translate: 0 1px;
  }

  /* The return link landed here: underline the step in pen. */
  .step:target .step__name {
    background: linear-gradient(var(--highlighter), var(--highlighter)) left
      bottom / 100% 40% no-repeat;
  }

  @media (max-width: 699.98px) {
    .coffee {
      left: -36px;
      bottom: -70px;
      width: 110px;
      height: 110px;
    }
  }
</style>
