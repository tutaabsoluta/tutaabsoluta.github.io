---
/**
 * The signature "printed" object: a pastel fill shape offset by a few pixels,
 * with a transparent graphite outline of the same shape on top.
 *
 * Size, offset and glyph size can come from props or from the parent's CSS
 * (`--printed-size`, `--printed-offset`, `--printed-glyph`).
 */
interface Props {
  /** Fill colour (CSS value). */
  fill: string;
  /** Border radius of both layers. */
  radius: string;
  /** Offset of the fill layer in px. */
  offset?: number;
  /** Width/height in px. */
  size?: number;
  glyph?: string;
  glyphSize?: number;
  class?: string;
}

const {
  fill,
  radius,
  offset,
  size,
  glyph,
  glyphSize,
  class: className,
} = Astro.props;

const vars = [
  `--fill:${fill}`,
  `--radius:${radius}`,
  offset !== undefined && `--printed-offset:${offset}px`,
  size !== undefined && `--printed-size:${size}px`,
  glyphSize !== undefined && `--printed-glyph:${glyphSize}px`,
]
  .filter(Boolean)
  .join(";");
---

<div class:list={["printed", className]} aria-hidden="true" style={vars}>
  <div class="printed__fill"></div>
  <div class="printed__line">
    {glyph === "⌕" ? (
      <svg
        class="printed__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
      >
        <circle cx="10.5" cy="10.5" r="6" />
        <path d="M15 15 L20 20" />
      </svg>
    ) : (
      glyph
    )}
  </div>
  <slot />
</div>

<style>
  .printed {
    position: relative;
    flex: none;
    width: var(--printed-size, auto);
    height: var(--printed-size, auto);
  }

  .printed__fill,
  .printed__line {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  /* Cards set --printed-align: 1 on hover to slide the fill back under the
     outline, so the "print" lines up. */
  .printed__fill {
    --at: calc(var(--printed-offset, 5px) * (1 - var(--printed-align, 0)));
    translate: var(--at) var(--at);
    background: var(--fill);
    transition: translate 0.25s var(--ease-settle);
  }

  /* The display font has no "⌕", so it is drawn to match the other glyphs. */
  .printed__icon {
    width: 1.25em;
    height: 1.25em;
  }

  .printed__line {
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border);
    font: 800 var(--printed-glyph, 20px) / 1 var(--font-display);
  }
</style>
